<%- include('../shared/top', { title }) %>

<div class="row checkout-grid">
  <div class="col">
    <div class="card card--pad-lg">
      <h1 class="h1">Checkout</h1>
      <form method="post" action="/checkout" id="checkoutForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>Customer name <span class="required-star" aria-hidden="true">*</span></label>
        <input class="input" name="customer_name" minlength="2" required value="<%= prefill ? (prefill.customer_name || '') : '' %>" />

        <label>Phone <span class="required-star" aria-hidden="true">*</span></label>
        <input class="input" name="phone" minlength="6" required value="<%= prefill ? (prefill.phone || '') : '' %>" />

        <label>Email <span class="required-star" aria-hidden="true">*</span></label>
        <input class="input" name="email" type="email" required value="<%= prefill ? (prefill.email || '') : '' %>" />

        <h2 class="h2 u-mt-12">Delivery address (Malaysia)</h2>

        <label>Address line 1 <span class="required-star" aria-hidden="true">*</span></label>
        <input class="input" name="address_line1" minlength="3" required value="<%= prefill ? (prefill.address_line1 || '') : '' %>" />

        <label>Address line 2 (optional)</label>
        <input class="input" name="address_line2" value="<%= prefill ? (prefill.address_line2 || '') : '' %>" />

        <label>City <span class="required-star" aria-hidden="true">*</span></label>
        <input class="input" name="city" minlength="2" required value="<%= prefill ? (prefill.city || '') : '' %>" />

        <label>State <span class="required-star" aria-hidden="true">*</span></label>
        <select class="input" name="state" id="stateSelect" required>
          <option value="">Select state</option>
          <% (malaysiaStates || []).forEach(s => { %>
            <option value="<%= s %>" <%= (prefill && prefill.state === s ? 'selected' : '') %>><%= s %></option>
          <% }) %>
        </select>

        <label>Postcode <span class="required-star" aria-hidden="true">*</span></label>
        <input class="input" name="postcode" inputmode="numeric" pattern="\d{5}" required value="<%= prefill ? (prefill.postcode || '') : '' %>" />

        <div class="muted small u-mt-6">
          Delivery zone: <strong id="regionLabel"><%= (typeof prefillShippingLabel !== 'undefined' && prefillShippingLabel) ? prefillShippingLabel : '-' %></strong>
          <span id="shippingMessage" class="muted shipping-message"></span>
        </div>

        <label>Promo code (optional)</label>
        <div class="row row--tight row--center">
          <div class="col">
            <input class="input" name="promo_code" id="promoCodeInput" placeholder="WELCOME10" />
          </div>
          <button class="btn" type="button" id="promoCheckBtn">Check</button>
        </div>
        <div class="muted small u-mt-6" id="promoMessage"></div>

        <label>Order remark (optional)</label>
        <textarea
          class="input"
          name="customer_note"
          rows="3"
          maxlength="500"
          placeholder="e.g. Leave at guardhouse / call before delivery"
        ></textarea>

        <label>Payment method</label>
        <select name="payment_method" id="paymentMethodSelect" required>
          <% if (canOnlinePay) { %>
            <option value="ONLINE">Online payment</option>
          <% } %>
          <option value="OFFLINE_TRANSFER">Offline bank transfer (upload slip)</option>
        </select>

        <div class="card card--pad card--mt" id="offlineBankDetails" style="display:none">
          <div class="muted small kicker">Offline bank transfer details</div>

          <% if (offlineTransferBanks && offlineTransferBanks.length) { %>
            <label>Select bank</label>
            <select class="input" name="offline_transfer_bank_id" id="offlineTransferBankSelect">
              <option value="">Select a bank</option>
              <% offlineTransferBanks.forEach(b => { %>
                <option
                  value="<%= b.id %>"
                  data-bank="<%= b.bank %>"
                  data-account-no="<%= b.account_no %>"
                  data-account-name="<%= b.account_name %>"
                ><%= b.bank %> — <%= b.account_no %></option>
              <% }) %>
            </select>
          <% } %>

          <div class="small u-mt-8">
            <div><strong>Bank Acc.</strong>: <span id="offlineBankName">-</span></div>
            <div><strong>Acc. No.</strong>: <span id="offlineAccountNo">-</span></div>
            <div><strong>Acc. Name</strong>: <span id="offlineAccountName">-</span></div>
          </div>
          <div class="muted small u-mt-8">After payment, upload your bank slip for verification.</div>
        </div>

        <div class="actions actions_primary u-mt-12">
          <button class="btn btn-primary" id="placeOrderBtn" type="submit">Place order</button>
          <button class="btn" type="button" data-href="/">Cancel</button>
        </div>

        <div id="checkoutFormMessage" class="muted small u-mt-8"></div>

        <div class="muted small u-mt-10">
          <% if (!canOnlinePay) { %>
            Online payment is currently disabled.
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <div class="col">
    <div class="card card--pad-lg">
      <h2 class="h2">Order summary</h2>
      <div
        id="checkoutTotals"
        data-items-total-cents="<%= Number(cart.total || 0) %>"
        data-discount-cents="0"
        data-csrf-token="<%= csrfToken %>"
        style="display:none"
      ></div>
      <table class="table">
        <thead>
          <tr><th>Item</th><th>Qty</th><th>Subtotal</th></tr>
        </thead>
        <tbody>
          <% cart.items.forEach(line => { %>
            <tr>
              <td>
                <div class="text-strong"><%= line.product.name %></div>
                <div class="muted small"><%= formatMoney(line.variant ? line.variant.price : line.product.price) %> each</div>
                <% if (line.variant) { %>
                  <div class="muted small">Type: <%= line.variant.label %></div>
                <% } else if (line.type) { %>
                  <div class="muted small">Type: <%= (typeof productTypeLabel !== 'undefined') ? productTypeLabel(line.type) : line.type %></div>
                <% } %>
                <% if (line.note) { %>
                  <div class="muted small">Note: <%= line.note %></div>
                <% } %>
                <% if (line.product && line.product.weight_kg != null) { %>
                  <div class="muted small">Weight: <%= Number(line.product.weight_kg || 0).toFixed(2) %> kg</div>
                <% } %>
              </td>
              <td><%= line.quantity %></td>
              <td><%= formatMoney(line.subtotal) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="kv u-mt-10">
        <span class="muted">Total weight</span>
        <strong><%= (typeof totalWeightKg !== 'undefined' ? Number(totalWeightKg || 0) : 0).toFixed(2) %> kg</strong>
      </div>
      <div class="kv u-mt-10"><span class="muted">Total</span> <strong><%= formatMoney(cart.total) %></strong></div>
      <div class="kv u-mt-6"><span class="muted">Courier charge</span> <strong id="shippingFee"><%= formatMoney(prefillShippingFee || 0) %></strong></div>
      <div class="kv u-mt-6"><span class="muted">Before discount</span> <strong id="preDiscountTotal"><%= formatMoney(cart.total + (prefillShippingFee || 0)) %></strong></div>
      <div class="kv u-mt-6"><span class="muted">Discount</span> <strong id="discountAmount"><%= formatMoney(0) %></strong></div>
      <div class="kv u-mt-6"><span class="muted">Grand total</span> <strong id="grandTotal"><%= formatMoney(cart.total + (prefillShippingFee || 0)) %></strong></div>
      <div class="muted small u-mt-8">
        Courier charge depends on your delivery zone and total cart weight.
      </div>
    </div>
  </div>
</div>

<script src="/public/js/checkout-shipping.js?v=3" defer></script>
<script src="/public/js/checkout-promo.js?v=3" defer></script>

<%- include('../shared/bottom') %>
