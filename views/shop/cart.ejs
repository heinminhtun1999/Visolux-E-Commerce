<%- include('../shared/top', { title }) %>

<div class="page-head">
  <div>
    <h1 class="h1">Cart</h1>
    <div class="muted small"><%= cart.items.length %> items</div>
  </div>
</div>

<div class="card card--pad card--mt">
  <% if (cart.items.length === 0) { %>
    <div class="muted">Your cart is empty.</div>
    <div class="actions u-mt-12">
      <button class="btn btn-primary" type="button" data-href="/">Browse categories</button>
    </div>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th class="table-col-qty">Qty</th>
          <th class="table-col-type">Type</th>
          <th class="table-col-note">Note</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% cart.items.forEach(line => { %>
          <% const formId = 'cart-line-' + String(line.key || '').replace(/[^a-z0-9_-]+/gi, '_'); %>
          <tr>
            <td>
              <div class="text-strong"><a href="/products/<%= line.product.product_id %>"><%= line.product.name %></a></div>
              <div class="muted small"><%= line.product.category_name || line.product.category %></div>
            </td>
            <td><%= formatMoney(line.variant ? line.variant.price : line.product.price) %></td>
            <td>
              <form method="post" action="/cart/update" class="row row--tight" id="<%= formId %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="cart_key" value="<%= String(line.key || '') %>" />
                <input type="hidden" name="product_id" value="<%= line.product.product_id %>" />
                <input type="hidden" name="variant_id" value="<%= line.variant ? line.variant.variant_id : '' %>" />
                <input type="hidden" name="product_type" value="<%= String(line.type || '') %>" />
                <input type="hidden" name="note" value="<%= String(line.note || '').trim() %>" />
                <input
                  class="input"
                  type="number"
                  min="0"
                  max="<%= Math.min(99, Math.max(0, Number(line.available_stock == null ? 0 : line.available_stock))) %>"
                  name="quantity"
                  value="<%= line.quantity %>"
                  inputmode="numeric"
                />
              </form>
            </td>
            <td>
              <% if (line.variant) { %>
                <div><%= line.variant.label %></div>
              <% } else { %>
                <div><%= ((typeof productTypeLabel !== 'undefined' && productTypeLabel) ? productTypeLabel(line.type) : String(line.type || '')) %></div>
              <% } %>
            </td>
            <td>
              <textarea
                class="input"
                form="<%= formId %>"
                data-cart-note
                rows="2"
                maxlength="500"
                placeholder="Note (optional)"
                aria-label="Note for <%= line.product.name %>"
              ><%= String(line.note || '').trim() %></textarea>
            </td>
            <td><%= formatMoney(line.subtotal) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (cart.items.length > 0) { %>
  <div class="row row--end u-mt-12">
    <div class="card card--pad cart-summary">
      <div class="kv"><span class="muted">Total</span> <strong><%= formatMoney(cart.total) %></strong></div>
      <div class="actions u-mt-10">
        <form method="post" action="/cart/clear" class="btn-grow">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn-danger btn-block" type="submit">Clear cart</button>
        </form>
        <button class="btn btn-primary btn-grow btn-block" type="button" data-href="/checkout">Checkout</button>
      </div>
    </div>
  </div>
<% } %>

<script src="/public/js/cart-auto-update.js" defer></script>
<%- include('../shared/bottom') %>
