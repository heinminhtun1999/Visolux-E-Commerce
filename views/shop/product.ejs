<%- include('../shared/top', { title }) %>

<div class="card card--pad-lg">
  <div class="row">
    <div class="col">
      <% const hasVariants = (typeof variants !== 'undefined' && variants && variants.length); %>
      <% const sellableVariants = hasVariants
        ? (variants || []).filter((v) => Boolean(Number((v && v.active) == null ? 1 : v.active)))
        : []; %>
      <% const defaultVariant = sellableVariants.length
        ? sellableVariants.reduce((best, v) => (!best || Number(v.price || 0) < Number(best.price || 0)) ? v : best, null)
        : null; %>
      <% const mainProductImg = (product && product.product_image) ? product.product_image : '/public/placeholder.svg'; %>
      <% const defaultVariantImg = (defaultVariant && defaultVariant.image_url) ? defaultVariant.image_url : null; %>
      <% const items = [mainProductImg]; %>
      <% if (defaultVariantImg && defaultVariantImg !== mainProductImg) items.push(defaultVariantImg); %>
      <% const mainImg = mainProductImg; %>
      <% const encodedGallery = items.map(u => encodeURIComponent(u)).join('|'); %>

      <div data-image-carousel data-items="<%= encodedGallery %>" data-main-image="<%= mainProductImg %>">
        <div class="zoom-pane" data-zoom-pane>
          <div class="product-carousel">
            <img data-zoom-img data-carousel-img src="<%= mainImg %>" alt="<%= product.name %>" />
            <button class="product-carousel__btn product-carousel__btn--prev" type="button" data-carousel-prev aria-label="Previous image">‹</button>
            <button class="product-carousel__btn product-carousel__btn--next" type="button" data-carousel-next aria-label="Next image">›</button>
          </div>
          <% const effStock = (product.available_stock == null ? product.stock : product.available_stock); %>
          <% if (effStock <= 0) { %>
            <div class="product-stock-overlay" aria-label="Out of stock"><%= (Number(product.stock || 0) > 0) ? 'Temporarily out of stock' : 'Out of stock' %></div>
          <% } %>
        </div>

        <div class="product-gallery">
          <% items.forEach((url, idx) => { %>
            <button class="product-gallery__thumb <%= idx === 0 ? 'is-active' : '' %>" type="button" data-carousel-thumb data-idx="<%= idx %>" aria-label="View image <%= idx + 1 %>">
              <img src="<%= url %>" alt="<%= product.name %> thumbnail <%= idx + 1 %>" loading="lazy" decoding="async" />
            </button>
          <% }) %>
        </div>
      </div>

      <div class="muted small u-mt-8">Scroll/pinch to zoom, drag to pan, double-click to reset.</div>
    </div>
    <div class="col">
      <h1 class="h1"><%= product.name %></h1>
      <div class="muted"><%= product.category_name || product.category %></div>
      <div class="product-price u-mt-10" data-product-price><%= defaultVariant ? formatMoney(defaultVariant.price) : formatMoney(product.price) %></div>
      <div class="u-mt-10">
        <% if (hasVariants) { %>
          <% const dvStock = Math.max(0, Math.floor(Number(defaultVariant && defaultVariant.stock || 0))); %>
          <span class="badge <%= dvStock > 0 ? 'ok' : 'no' %>" data-product-stock><%= dvStock > 0 ? ('In stock: ' + dvStock) : 'Out of stock' %></span>
        <% } else if (effStock > 0) { %>
          <span class="badge ok" data-product-stock>In stock: <%= effStock %></span>
        <% } else { %>
          <span class="badge no" data-product-stock><%= (Number(product.stock || 0) > 0) ? 'Temporarily out of stock' : 'Out of stock' %></span>
        <% } %>
      </div>
      <div class="muted u-mt-12">
        <% if (String(product.description_html || '').trim()) { %>
          <div class="md"><%- product.description_html %></div>
        <% } else { %>
          <p class="muted"><%= product.description %></p>
        <% } %>
      </div>

      <% if (isAdmin && hasVariants) { %>
        <div class="u-mt-12">
          <div style="font-weight:800">Variants</div>
          <div class="muted small u-mt-6">Admin view: variants are shown for review only (admin accounts cannot add to cart).</div>

          <div class="table-scroll u-mt-8">
            <table class="table" style="min-width:0">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Price</th>
                  <th>Stock</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% (variants || []).forEach(v => { %>
                  <% const isActive = Boolean(Number((v && v.active) == null ? 1 : v.active)); %>
                  <% const st = Math.max(0, Math.floor(Number(v && v.stock || 0))); %>
                  <tr>
                    <td><%= v.label %></td>
                    <td><%= formatMoney(v.price) %></td>
                    <td>
                      <span class="badge <%= st > 0 ? 'ok' : 'no' %>"><%= st > 0 ? ('In stock: ' + st) : 'Out of stock' %></span>
                    </td>
                    <td>
                      <span class="badge <%= isActive ? 'ok' : 'warn' %>"><%= isActive ? 'Enabled' : 'Disabled' %></span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <% if (!isAdmin) { %>
        <form method="post" action="/cart/add" class="row row--align-end u-mt-12">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="product_id" value="<%= product.product_id %>" />
          <input type="hidden" name="return_to" value="<%= currentUrl %>" />
          <div class="field is-xs">
            <label>Qty</label>
            <input class="input" type="number" name="quantity" min="1" max="<%= Math.min(99, Math.max(1, effStock || 1)) %>" value="1" <%= effStock > 0 ? '' : 'disabled' %> />
          </div>
          <% if (hasVariants) { %>
            <div class="field is-sm">
              <label>Type</label>
              <select class="input" name="variant_id" data-variant-select required <%= effStock > 0 ? '' : 'disabled' %>>
                <option value="" selected disabled data-placeholder="1">Please select a type</option>
                <% (variants || []).forEach(v => { %>
                  <% const isActive = Boolean(Number((v && v.active) == null ? 1 : v.active)); %>
                  <option
                    value="<%= v.variant_id %>"
                    <%= (!isActive && isAdmin) ? 'disabled' : '' %>
                    data-price-label="<%= formatMoney(v.price) %>"
                    data-stock="<%= Math.max(0, Math.floor(Number(v.stock || 0))) %>"
                    data-image-url="<%= v.image_url || '' %>"
                  ><%= v.label %><%= (!isActive && isAdmin) ? ' (Disabled)' : '' %></option>
                <% }) %>
              </select>
            </div>
          <% } else { %>
            <div class="field is-sm">
              <label>Type</label>
              <select class="input" name="product_type" required <%= effStock > 0 ? '' : 'disabled' %>>
                <option value="" selected disabled data-placeholder="1">Please select a type</option>
                <% ((typeof productTypeOptions !== 'undefined' && productTypeOptions) ? productTypeOptions() : []).forEach(opt => { %>
                  <option value="<%= opt.key %>"><%= opt.label %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div class="field is-md">
            <label>Note (optional)</label>
            <input class="input" type="text" name="note" maxlength="500" placeholder="e.g. color/variant, delivery instruction" <%= effStock > 0 ? '' : 'disabled' %> />
          </div>
          <div class="field is-md" id="add-to-cart">
            <label>&nbsp;</label>
            <button class="btn btn-primary" type="submit" <%= effStock > 0 ? '' : 'disabled' %>>Add to cart</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>
</div>

<script src="/public/js/zoom-pan.js" defer></script>
<script src="/public/js/image-carousel.js" defer></script>
<script src="/public/js/product-variants.js" defer></script>

<%- include('../shared/bottom') %>
