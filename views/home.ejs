<%- include('./shared/top', { title }) %>

<div class="card card--pad-lg">
  <div class="home-hero">
    <div>
      <h1 class="h1 u-m0">Visolux Store</h1>
      <div class="muted u-mt-6">Shop parts and components online. Select a category to start shopping.</div>
    </div>
  </div>

  <div class="home-categories u-mt-14">
    <% categories.forEach(c => { %>
      <a href="/categories/<%= encodeURIComponent(c.slug) %>" class="category-tile link-reset" aria-label="Browse <%= c.name %>">
        <div class="category-tile__media">
          <% if (c.image_url) { %>
            <img src="<%= c.image_url %>" alt="<%= c.name %>" loading="lazy" decoding="async" />
          <% } else { %>
            <div class="category-tile__placeholder">
              <span class="muted small">No image</span>
            </div>
          <% } %>
          <div class="category-tile__overlay" aria-hidden="true"></div>
        </div>
        <div class="category-tile__body">
          <div class="category-tile__title"><%= c.name %></div>
          <div class="category-tile__subtitle">Browse products</div>
          <div class="category-tile__cta">
            <span>Shop now</span>
            <span aria-hidden="true">→</span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
</div>

<%- include('./shared/bottom') %>
