<%- include('../shared/top', { title }) %>

<% const scopeSafe = (typeof scope !== 'undefined' && scope) ? String(scope) : 'all'; %>
<% const fiuuAccountLabelMapSafe = (typeof fiuuAccountLabelMap !== 'undefined' && fiuuAccountLabelMap && typeof fiuuAccountLabelMap === 'object') ? fiuuAccountLabelMap : {}; %>
<% function resolveFiuuAccountLabel(v) { const id = String(v == null ? '' : v).trim(); if (!id) return ''; return (fiuuAccountLabelMapSafe && fiuuAccountLabelMapSafe[id]) ? String(fiuuAccountLabelMapSafe[id]) : id; } %>

<div class="row" style="justify-content:space-between; align-items:flex-end; gap:12px">
  <div>
    <h1 class="h1"><%= scopeSafe === 'all' ? 'Activity' : 'Settings history' %></h1>
    <% if (scopeSafe === 'all') { %>
      <div class="muted small">All admin logs (useful for debugging).</div>
    <% } else { %>
      <div class="muted small">Tracks configuration changes made by admins (not page views).</div>
    <% } %>
  </div>
</div>

<div class="card card--pad card--mt">
  <form method="get" action="/admin/activity" class="row" style="align-items:flex-end; gap:10px">
    <div class="col" style="min-width:260px">
      <label>Search</label>
      <input class="input" name="q" value="<%= q %>" placeholder="search by action or user" />
    </div>

    <div style="width:180px">
      <label>Show</label>
      <select name="scope">
        <% const scopes = [{ v: 'all', label: 'All changes' }, { v: 'settings', label: 'Settings only' }]; %>
        <% scopes.forEach(s => { %>
          <option value="<%= s.v %>" <%= scopeSafe === String(s.v) ? 'selected' : '' %>><%= s.label %></option>
        <% }) %>
      </select>
    </div>

    <div style="width:200px">
      <label>Actor user ID</label>
      <input class="input" name="actorUserId" value="<%= actorUserId %>" placeholder="e.g. 1" inputmode="numeric" />
    </div>

    <div style="width:160px">
      <label>Per page</label>
      <select name="pageSize">
        <% [25,50,100,200].forEach(n => { %>
          <option value="<%= n %>" <%= String(pageSize) === String(n) ? 'selected' : '' %>><%= n %></option>
        <% }) %>
      </select>
    </div>

    <div class="actions" style="margin-left:auto">
      <button class="btn btn-primary" type="submit">Apply</button>
      <button class="btn" type="button" data-href="/admin/activity">Clear</button>
    </div>
  </form>

  <div style="margin-top:12px" class="muted small"><%= total %> total</div>

  <div style="overflow:auto; margin-top:12px">
    <table class="table" data-table-sort>
      <thead>
        <tr>
          <th data-sort="string">When</th>
          <th data-sort="string">Actor</th>
          <th data-sort="string">Action</th>
          <th data-sort="string">Result</th>
        </tr>
      </thead>
      <tbody>
        <% if (!events || !events.length) { %>
          <tr><td colspan="4" class="muted">No activity found.</td></tr>
        <% } else { %>
          <% events.forEach(ev => { %>
            <tr>
              <td class="muted"><%= (typeof formatDateTime === 'function') ? formatDateTime(ev.created_at) : (ev.created_at || '') %></td>
              <td>
                <strong><%= ev.actor_username %></strong>
                <% if (ev.actor_is_super_admin) { %>
                  <span class="badge ok" style="margin-left:6px">Main</span>
                <% } %>
                <div class="muted small">#<%= ev.actor_user_id %></div>
              </td>
              <td>
                <% const simplifyUpload = (v) => { const s = String(v == null ? '' : v).trim(); if (!s) return s; if (s.indexOf('/uploads/') === -1) return s; const parts = s.split('/').filter(Boolean); return parts.length ? parts[parts.length - 1] : s; }; %>
                <% const formatMetaValue = (v) => { if (v == null) return ''; if (typeof v === 'string') return simplifyUpload(v); if (typeof v === 'number' || typeof v === 'boolean') return String(v); return String(v); }; %>
                <% const metaSafe = ev && ev.meta && typeof ev.meta === 'object' ? ev.meta : {}; %>
                <% const entity = String(metaSafe.entity || '').trim(); %>
                <% const variantId = metaSafe.variantId != null ? Number(metaSafe.variantId) : null; %>
                <% const productId = metaSafe.productId != null ? Number(metaSafe.productId) : null; %>
                <% let actionText = simplifyUpload(ev && ev.action ? ev.action : 'Performed an admin action'); %>
                <% if (entity === 'variant_image' && Number.isFinite(variantId)) { %>
                  <% actionText = `Deleted variant image (Variant #${variantId})`; %>
                <% } else if (entity === 'product_image' && Number.isFinite(productId)) { %>
                  <% actionText = `Deleted main image (Product #${productId})`; %>
                <% } %>
                <div><%= actionText %></div>
                <% const ch = Array.isArray(metaSafe.changes) ? metaSafe.changes : []; %>
                <% if (ch.length) { %>
                  <div class="muted small" style="margin-top:6px">
                    <% ch.slice(0, 8).forEach(c => { %>
                      <% const isFiuuAccount = String(c.field || '').trim() === 'fiuu_account_id'; %>
                      <% const isImageField = /image|image_url|product_image/i.test(String(c.field || '')); %>
                      <% const beforeRaw = isFiuuAccount ? resolveFiuuAccountLabel(c.before) : c.before; %>
                      <% const afterRaw = isFiuuAccount ? resolveFiuuAccountLabel(c.after) : c.after; %>
                      <% const beforeShown = isImageField ? simplifyUpload(beforeRaw) : beforeRaw; %>
                      <% const afterShown = isImageField ? simplifyUpload(afterRaw) : afterRaw; %>
                      <div>
                        <strong><%= c.label || c.field || 'Field' %></strong>: <%= (beforeShown == null || String(beforeShown) === '') ? '—' : beforeShown %> → <%= (afterShown == null || String(afterShown) === '') ? '—' : afterShown %>
                      </div>
                    <% }) %>
                    <% if (ch.length > 8) { %>
                      <div>… (+<%= ch.length - 8 %> more)</div>
                    <% } %>
                  </div>
                <% } else if (metaSafe && metaSafe.body && typeof metaSafe.body === 'object') { %>
                  <% const bodyEntries = Object.entries(metaSafe.body || {}).filter(([k, v]) => String(k || '').trim() && k !== '_csrf'); %>
                  <% if (bodyEntries.length) { %>
                    <div class="muted small" style="margin-top:6px">
                      <% bodyEntries.slice(0, 8).forEach(([k, v]) => { %>
                        <% const shown = formatMetaValue(v); %>
                        <div><strong><%= k %></strong>: <%= shown === '' ? '—' : shown %></div>
                      <% }) %>
                      <% if (bodyEntries.length > 8) { %>
                        <div>… (+<%= bodyEntries.length - 8 %> more)</div>
                      <% } %>
                    </div>
                  <% } %>
                <% } %>
              </td>
              <td>
                <% if (ev.status_code != null && ev.status_code >= 400) { %>
                  <span class="badge no">Failed</span>
                <% } else { %>
                  <span class="badge ok">OK</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <% const qs = new URLSearchParams(); %>
  <% if (q) qs.set('q', q); %>
  <% if (actorUserId) qs.set('actorUserId', actorUserId); %>
  <% if (pageSize) qs.set('pageSize', String(pageSize)); %>
  <% if (scopeSafe) qs.set('scope', scopeSafe); %>
  <%- include('../shared/pagination', { basePath: '/admin/activity', query: qs.toString(), page, pageCount }) %>
</div>

<%- include('../shared/bottom') %>
