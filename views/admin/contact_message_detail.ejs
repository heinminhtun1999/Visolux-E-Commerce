<%- include('../shared/top', { title }) %>

<div class="row" style="justify-content:space-between; align-items:flex-end">
  <div>
    <h1 class="h1">Admin – Contact message</h1>
    <div class="muted small">Message #<%= message.id %> • <%= formatDateTime(message.created_at) %></div>
  </div>
  <div class="actions icon-row">
    <button class="btn btn-icon icon-only" type="button" data-href="/admin/contact-messages" title="Back" aria-label="Back" data-label="Back"><%- icon('back') %></button>

    <% if (!message.is_read) { %>
      <form method="post" action="/admin/contact-messages/<%= message.id %>/read" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-icon icon-only" type="submit" title="Mark read" aria-label="Mark read" data-label="Mark read"><%- icon('check') %></button>
      </form>
    <% } else { %>
      <form method="post" action="/admin/contact-messages/<%= message.id %>/unread" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-icon icon-only" type="submit" title="Mark new" aria-label="Mark new" data-label="Mark new"><%- icon('x') %></button>
      </form>
    <% } %>

        <form method="post" action="/admin/contact-messages/<%= message.id %>/delete" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn-icon icon-only" type="submit" title="Delete" aria-label="Delete" data-label="Delete" data-confirm="Delete this message?" data-confirm-title="Delete message" data-confirm-ok="Delete"><%- icon('trash-2') %></button>
    </form>
  </div>
</div>

<div class="card card--pad card--mt">
  <div class="row" style="gap:14px; flex-wrap:wrap; align-items:flex-start">
    <div class="col" style="min-width:280px">
      <div class="muted small">Status</div>
      <% if (message.is_read) { %><span class="badge">Read</span><% } else { %><span class="badge ok">New</span><% } %>
    </div>

    <div class="col" style="min-width:280px">
      <div class="muted small">Name</div>
      <% if (message.name || message.phone) { %>
        <div><%= message.name || message.phone %></div>
      <% } else { %>
        <div class="muted">(not provided)</div>
      <% } %>
    </div>

    <div class="col" style="min-width:280px">
      <div class="muted small">Company</div>
      <% if (message.company_name) { %>
        <div><%= message.company_name %></div>
      <% } else { %>
        <div class="muted">(not provided)</div>
      <% } %>
    </div>

    <div class="col" style="min-width:280px">
      <div class="muted small">Email</div>
      <% if (message.email) { %>
        <div><a href="mailto:<%= message.email %>"><%= message.email %></a></div>
      <% } else { %>
        <div class="muted">(not provided)</div>
      <% } %>
    </div>

    <div class="col" style="min-width:280px">
      <div class="muted small">Contact number</div>
      <% if (message.contact_number) { %>
        <div><a href="tel:<%= String(message.contact_number).replace(/\s+/g, '') %>"><%= message.contact_number %></a></div>
      <% } else { %>
        <div class="muted">(not provided)</div>
      <% } %>
    </div>

    <div class="col" style="min-width:280px">
      <div class="muted small">Subject</div>
      <% if (message.subject || message.location) { %>
        <div><%= message.subject || message.location %></div>
      <% } else { %>
        <div class="muted">(not provided)</div>
      <% } %>
    </div>
  </div>

  <div style="margin-top:14px">
    <div class="muted small">Message</div>
    <div class="message-bubble" style="margin-top:6px; white-space:pre-wrap"><%= message.message %></div>
  </div>
</div>

<%- include('../shared/bottom') %>
