<%- include('../shared/top', { title }) %>

<div class="card" style="padding:16px; width:100%">
  <h1 class="h1"><%= product ? ('Edit #' + product.product_id) : 'New product' %></h1>

  <form method="post" action="<%= product ? ('/admin/products/' + product.product_id + '/edit') : '/admin/products/new' %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>Name</label>
    <input class="input" name="name" value="<%= product ? product.name : '' %>" required />

    <label>Description</label>
    <textarea class="input" name="description" rows="6" data-product-desc-textarea><%= product ? product.description : '' %></textarea>
    <textarea name="description_html" style="display:none" data-product-desc-html><%- product ? (product.description_html || '') : '' %></textarea>
    <div class="rte" data-product-desc-editor style="display:none; margin-top:10px">
      <div class="ql-toolbar ql-snow" data-product-desc-toolbar></div>
      <div class="rte__editor" style="min-height:160px"></div>
      <div class="muted small" style="margin-top:6px">Images are disabled in the description. Use the gallery upload below.</div>
    </div>

    <label>Category</label>
    <select name="category" required>
      <% if (!categories || !categories.length) { %>
        <option value="" disabled selected>No categories yet</option>
      <% } else { %>
        <% categories.forEach(c => { %>
          <option value="<%= c.slug %>" <%= product && product.category===c.slug ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      <% } %>
    </select>

    <% const isNewProduct = !product; %>
    <% if (isNewProduct) { %>
      <hr class="divider" />
      <h2 class="h2">Default variant</h2>
      <div class="muted small" style="margin-top:6px">A new product starts with one variant.</div>

      <div class="row" style="margin-top:10px">
        <div class="col" style="min-width:220px">
          <label>Variant key</label>
          <input class="input" name="type_key" value="" readonly aria-disabled="true" tabindex="-1" data-variant-type-key placeholder="Auto" />
          <div class="muted small" style="margin-top:6px">Auto-generated from the label.</div>
        </div>
        <div class="col" style="min-width:240px">
          <label>Variant label</label>
          <input class="input" name="label" value="Default" required data-variant-label />
        </div>
      </div>
    <% } %>

    <div class="row">
      <div class="col" style="min-width:220px">
        <label>Selling price (RM)</label>
        <% const hasVariants = Boolean(product && (typeof variants !== 'undefined') && variants && variants.length); %>
        <% if (hasVariants) { %>
          <input class="input" type="number" min="1" step="0.01" value="<%= product ? (product.price/100).toFixed(2) : '1.00' %>" disabled />
          <input type="hidden" name="price" value="<%= product ? (product.price/100).toFixed(2) : '1.00' %>" />
          <div class="muted small" style="margin-top:6px">Derived from the lowest active variant price.</div>
        <% } else { %>
          <input class="input" name="price" type="number" min="1" step="0.01" value="<%= product ? (product.price/100).toFixed(2) : '1.00' %>" required />
        <% } %>
      </div>
      <% if (!hasVariants) { %>
        <div class="col" style="min-width:220px">
          <label>Cost price (RM)</label>
          <input class="input" name="cost_price" type="number" min="0" step="0.01" value="<%= (product && product.cost_price != null) ? (product.cost_price/100).toFixed(2) : '' %>" placeholder="e.g. 8.50" />
          <div class="muted small" style="margin-top:6px">Optional. Used for reports and profit calculations.</div>
        </div>
      <% } %>
      <div class="col" style="min-width:220px">
        <label>Stock</label>
        <% const hasVariantsForStock = hasVariants; %>
        <% if (hasVariantsForStock) { %>
          <input class="input" type="number" min="0" value="<%= product ? product.stock : 0 %>" disabled />
          <input type="hidden" name="stock" value="<%= product ? product.stock : 0 %>" />
        <% } else { %>
          <input class="input" name="stock" type="number" min="0" value="<%= product ? product.stock : 0 %>" required />
        <% } %>
      </div>
    </div>

    <% if (isNewProduct) { %>
      <div class="row">
        <div class="col" style="min-width:220px">
          <label>Active</label>
          <select name="active">
            <option value="1" selected>Enabled</option>
            <option value="0">Disabled</option>
          </select>
        </div>
        <div class="col" style="min-width:220px">
          <label>Sort order</label>
          <input class="input" name="sort_order" type="number" step="1" value="0" />
        </div>
        <div class="col" style="min-width:260px">
          <label>Variant image (optional)</label>
          <input class="input" type="file" name="variant_image" accept="image/*" />
        </div>
      </div>
    <% } %>

    <% if (!hasVariants) { %>
      <div class="row">
        <div class="col" style="min-width:220px">
          <label>Weight (kg)</label>
          <input class="input" name="weight_kg" type="number" min="0" step="0.001" value="<%= (product && product.weight_kg != null) ? product.weight_kg : '' %>" placeholder="e.g. 0.35" />
        </div>
        <div class="col" style="min-width:220px">
          <label>Height (cm)</label>
          <input class="input" name="height_cm" type="number" min="0" step="0.1" value="<%= (product && product.height_cm != null) ? product.height_cm : '' %>" placeholder="e.g. 10" />
        </div>
        <div class="col" style="min-width:220px">
          <label>Length (cm)</label>
          <input class="input" name="length_cm" type="number" min="0" step="0.1" value="<%= (product && product.length_cm != null) ? product.length_cm : '' %>" placeholder="e.g. 20" />
        </div>
        <div class="col" style="min-width:220px">
          <label>Width (cm)</label>
          <input class="input" name="width_cm" type="number" min="0" step="0.1" value="<%= (product && product.width_cm != null) ? product.width_cm : '' %>" placeholder="e.g. 15" />
        </div>
      </div>
    <% } %>

    <div class="row">
      <div class="col" style="min-width:220px">
        <label>Visibility</label>
        <select name="visibility">
          <option value="1" <%= !product || product.visibility ? 'selected' : '' %>>Visible</option>
          <option value="0" <%= product && !product.visibility ? 'selected' : '' %>>Hidden</option>
        </select>
      </div>
      <div class="col" style="min-width:220px">
        <label>Archived</label>
        <select name="archived">
          <option value="0" <%= !product || !product.archived ? 'selected' : '' %>>No</option>
          <option value="1" <%= product && product.archived ? 'selected' : '' %>>Yes</option>
        </select>
      </div>
    </div>

    <% if (product && product.archived) { %>
      <div class="muted small" style="margin-top:8px">
        This product is archived and will not appear on the storefront, even if some variants are enabled.
        Unarchive the product to make it available again.
      </div>
    <% } %>

    <label>Product images</label>
    <input class="input" type="file" name="product_images" accept="image/*" />
    <div class="muted small" style="margin-top:6px">Tip: upload one main product image.</div>

    <% if (product && product.product_image) { %>
      <div style="margin-top:12px">
        <div class="muted small" style="margin-bottom:6px">Main image</div>
        <img class="product-img" style="height:220px" src="<%= product.product_image %>" alt="" />
      </div>
    <% } %>

    <div class="actions" style="margin-top:12px">
      <button class="btn btn-primary btn-icon" type="submit" title="Save" aria-label="Save" data-label="Save"><%- product ? 'Save' : 'Add' %></button>
      <button class="btn btn-icon" type="button" data-href="/admin/products" title="Cancel" aria-label="Cancel" data-label="Cancel">Cancel</button>
    </div>
  </form>

  <% if (product) { %>
    <hr class="divider" />
    <h2 class="h2">Variants (Types)</h2>
      <div class="muted small" style="margin-top:6px">Each variant can have its own price, stock, cost, dimensions, weight, and image.</div>

    <% if (!variants || !variants.length) { %>
      <div class="muted small" style="margin-top:10px">No variants yet.</div>
    <% } else { %>
      <div class="grid" style="grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); margin-top:12px">
        <% variants.forEach(v => { %>
          <div class="card" style="padding:12px">
            <div class="muted small">Variant #<%= v.variant_id %></div>
            <% if (!v.active) { %>
              <div class="muted small" style="margin-top:4px">Status: <strong>Disabled</strong></div>
            <% } %>

            <% if (v.image_url) { %>
              <img class="product-img" style="height:140px; margin-top:8px" src="<%= v.image_url %>" alt="" />
            <% } %>

            <form method="post" action="/admin/products/<%= product.product_id %>/variants/<%= v.variant_id %>/edit" enctype="multipart/form-data" style="margin-top:10px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

              <label>Type key</label>
              <input class="input" name="type_key" value="<%= v.type_key %>" readonly aria-disabled="true" tabindex="-1" required />

              <label>Label</label>
              <input class="input" name="label" value="<%= v.label %>" required />

              <div class="row">
                <div class="col" style="min-width:160px">
                  <label>Price (RM)</label>
                  <input class="input" name="price" type="number" min="1" step="0.01" value="<%= (v.price/100).toFixed(2) %>" required />
                </div>
                <div class="col" style="min-width:160px">
                  <label>Cost (RM)</label>
                  <input class="input" name="cost_price" type="number" min="0" step="0.01" value="<%= (v.cost_price != null) ? (v.cost_price/100).toFixed(2) : '' %>" placeholder="e.g. 8.50" />
                </div>
                <div class="col" style="min-width:160px">
                  <label>Stock</label>
                  <input class="input" name="stock" type="number" min="0" value="<%= v.stock %>" required />
                </div>
              </div>

              <div class="row">
                <div class="col" style="min-width:160px">
                  <label>Weight (kg)</label>
                  <input class="input" name="weight_kg" type="number" min="0" step="0.001" value="<%= (v.weight_kg != null) ? v.weight_kg : '' %>" placeholder="e.g. 0.35" />
                </div>
                <div class="col" style="min-width:160px">
                  <label>Height (cm)</label>
                  <input class="input" name="height_cm" type="number" min="0" step="0.1" value="<%= (v.height_cm != null) ? v.height_cm : '' %>" placeholder="e.g. 10" />
                </div>
                <div class="col" style="min-width:160px">
                  <label>Length (cm)</label>
                  <input class="input" name="length_cm" type="number" min="0" step="0.1" value="<%= (v.length_cm != null) ? v.length_cm : '' %>" placeholder="e.g. 20" />
                </div>
                <div class="col" style="min-width:160px">
                  <label>Width (cm)</label>
                  <input class="input" name="width_cm" type="number" min="0" step="0.1" value="<%= (v.width_cm != null) ? v.width_cm : '' %>" placeholder="e.g. 15" />
                </div>
              </div>

              <div class="row">
                <div class="col" style="min-width:160px">
                  <label>Active</label>
                  <select name="active">
                    <option value="1" <%= v.active ? 'selected' : '' %>>Enabled</option>
                    <option value="0" <%= !v.active ? 'selected' : '' %>>Disabled</option>
                  </select>
                </div>
                <div class="col" style="min-width:160px">
                  <label>Sort order</label>
                  <input class="input" name="sort_order" type="number" step="1" value="<%= (v.sort_order || 0) %>" />
                </div>
              </div>

              <label>Variant image (optional)</label>
              <input class="input" type="file" name="variant_image" accept="image/*" />

              <div class="actions" style="margin-top:10px; width: 100%;">
                <button class="btn btn-primary btn-icon" type="submit" title="Save variant" aria-label="Save variant" data-label="Save variant" style="width: 100%;">Save</button>
              </div>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="card" style="padding:12px; margin-top:14px">
      <div class="h3">Add variant</div>
      <form method="post" action="/admin/products/<%= product.product_id %>/variants/new" enctype="multipart/form-data" style="margin-top:8px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="row">
          <div class="col" style="min-width:200px">
            <label>Type key</label>
            <input class="input" name="type_key" placeholder="Auto" readonly aria-disabled="true" tabindex="-1" required data-variant-type-key />
          </div>
          <div class="col" style="min-width:240px">
            <label>Label</label>
            <input class="input" name="label" placeholder="" required data-variant-label />
          </div>
        </div>

        <div class="row">
          <div class="col" style="min-width:200px">
            <label>Price (RM)</label>
            <input class="input" name="price" type="number" min="1" step="0.01" value="1.00" required />
          </div>
          <div class="col" style="min-width:200px">
            <label>Cost (RM)</label>
            <input class="input" name="cost_price" type="number" min="0" step="0.01" value="" placeholder="e.g. 8.50" />
          </div>
          <div class="col" style="min-width:200px">
            <label>Stock</label>
            <input class="input" name="stock" type="number" min="0" value="0" required />
          </div>
          <div class="col" style="min-width:200px">
            <label>Active</label>
            <select name="active">
              <option value="1" selected>Enabled</option>
              <option value="0">Disabled</option>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col" style="min-width:200px">
            <label>Weight (kg)</label>
            <input class="input" name="weight_kg" type="number" min="0" step="0.001" value="" placeholder="e.g. 0.35" />
          </div>
          <div class="col" style="min-width:200px">
            <label>Height (cm)</label>
            <input class="input" name="height_cm" type="number" min="0" step="0.1" value="" placeholder="e.g. 10" />
          </div>
          <div class="col" style="min-width:200px">
            <label>Length (cm)</label>
            <input class="input" name="length_cm" type="number" min="0" step="0.1" value="" placeholder="e.g. 20" />
          </div>
          <div class="col" style="min-width:200px">
            <label>Width (cm)</label>
            <input class="input" name="width_cm" type="number" min="0" step="0.1" value="" placeholder="e.g. 15" />
          </div>
        </div>

        <div class="row">
          <div class="col" style="min-width:200px">
            <label>Sort order</label>
            <input class="input" name="sort_order" type="number" step="1" value="0" />
          </div>
          <div class="col" style="min-width:260px">
            <label>Variant image (optional)</label>
            <input class="input" type="file" name="variant_image" accept="image/*" />
          </div>
        </div>

        <div class="actions" style="margin-top:10px">
          <button class="btn btn-primary btn-icon" type="submit" title="Add variant" aria-label="Add variant" data-label="Add variant">Add variant</button>
        </div>
      </form>
    </div>
  <% } %>

  
</div>

<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js" defer></script>
<script src="/public/js/admin-product-editor.js" defer></script>

<%- include('../shared/bottom') %>
