<%- include('../shared/top', { title }) %>

<div class="row" style="justify-content:space-between; align-items:flex-end">
  <div>
    <h1 class="h1">Admin – Backups</h1>
    <div class="muted small">Checkpoint backups (database + uploads) and restore.</div>
  </div>

  <div class="actions" style="gap:8px">
    <button class="btn" type="button" data-href="/admin/settings">Back to settings</button>
  </div>
</div>

<div class="card" style="padding:14px; margin-top:12px">
  <!-- <div class="muted small">Backups folder</div> -->
  <!-- <div style="font-weight:800; margin-top:4px"><%= (typeof backupsDir !== 'undefined' && backupsDir) ? backupsDir : '' %></div> -->
  <!-- <div class="muted small" style="margin-top:6px">Tip: you can set <code>BACKUPS_DIR</code> in the server environment to change this location.</div> -->
  <div class="muted small" style="margin-top:6px">Retention: backups older than <strong><%= (typeof backupsRetentionDays !== 'undefined' && backupsRetentionDays != null) ? backupsRetentionDays : 7 %></strong> days are deleted automatically (<code>BACKUP_RETENTION_DAYS</code>).</div>
  <div class="muted small" style="margin-top:6px">Times shown in: <strong><%= (typeof appTimeZone !== 'undefined' && appTimeZone) ? appTimeZone : 'local time' %></strong></div>
</div>

<% if (typeof backupsError !== 'undefined' && backupsError) { %>
  <div class="card" style="padding:12px; margin-top:12px; border:1px solid rgba(200,0,0,0.35)">
    <div style="font-weight:800">Could not list backups</div>
    <div class="muted small" style="margin-top:6px"><%= backupsError %></div>
  </div>
<% } %>

<div class="row" style="justify-content:space-between; align-items:flex-end; gap:12px; flex-wrap:wrap; margin-top:12px">
  <div>
    <% const bs = (typeof backups !== 'undefined' && backups) ? backups : []; %>
    <div style="font-weight:800">Available backups (<%= bs.length %>)</div>
    <div class="muted small">To minimize storage inflation, new backups are created as a single <code>.tgz</code> archive that includes the database and uploads.</div>
  </div>

  <form method="post" action="/admin/backups/create" style="display:inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button class="btn btn-primary" type="submit">Create backup now</button>
  </form>
</div>

<div class="card" style="padding:14px; margin-top:12px">
  <% if (!bs.length) { %>
    <div class="muted small">No backups found yet.</div>
  <% } else { %>
    <form id="multiDeleteForm" method="post" action="/admin/backups/delete" style="margin-bottom:10px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="confirm" value="1" />
      <div class="row" style="justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap">
        <div class="muted small">Select backups below, then delete in one action.</div>
        <div class="actions" style="gap:10px">
          <button id="deleteSelectedBtn" class="btn" type="button" disabled>Delete selected</button>
        </div>
      </div>
    </form>

    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th style="width:44px">
              <input id="selectAllBackups" type="checkbox" title="Select all" />
            </th>
            <th>Checkpoint</th>
            <th>Size</th>
            <th>Modified</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% bs.forEach(b => { %>
            <tr>
              <td>
                <input class="backup-select" type="checkbox" name="files" value="<%= b.name %>" form="multiDeleteForm" />
              </td>
              <td style="min-width:320px">
                <div style="font-weight:800"><%= (b.checkpointSqliteUtc && typeof formatDateTime === 'function') ? formatDateTime(b.checkpointSqliteUtc) : (b.checkpointLabel || b.name) %></div>
                <div class="muted small" style="margin-top:4px"><%= b.kind || '' %></div>
                <div class="muted small" style="margin-top:4px"><%= b.name %></div>
              </td>
              <td style="min-width:110px"><%= ((b.sizeBytes || 0) / 1024 / 1024).toFixed(1) %> MB</td>
              <td style="min-width:210px"><%= (typeof formatDateTime === 'function') ? formatDateTime(new Date(b.mtimeMs || 0).toISOString()) : new Date(b.mtimeMs || 0).toISOString() %></td>
              <td style="min-width:280px">
                <div class="actions" style="gap:8px; flex-wrap:wrap">
                  <a class="btn" href="/admin/backups/download?file=<%= encodeURIComponent(b.name) %>">Download</a>
                  <button class="btn js-restore" type="button" data-file="<%= b.name %>">Restore</button>
                  <button class="btn js-delete" type="button" data-file="<%= b.name %>">Delete</button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <form id="singleRestoreForm" method="post" action="/admin/backups/restore" style="display:none">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="file" value="" />
      <input type="hidden" name="confirm" value="1" />
      <input type="hidden" name="restore_uploads" value="" />
      <input type="hidden" name="restore_sessions" value="" />
    </form>

    <form id="singleDeleteForm" method="post" action="/admin/backups/delete" style="display:none">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="file" value="" />
      <input type="hidden" name="confirm" value="1" />
    </form>

    <div class="modal" data-backup-modal aria-hidden="true">
      <div class="modal__backdrop" data-modal-backdrop></div>
      <div class="modal__panel" role="dialog" aria-modal="true" aria-label="Backup action" style="width:min(720px, 100%)">
        <div class="modal__top">
          <div class="modal__title" data-backup-modal-title>Backup</div>
          <button class="btn btn-icon icon-only" type="button" data-modal-close title="Close" aria-label="Close" data-label="Close"><%- (typeof icon === 'function') ? icon('x') : 'Close' %></button>
        </div>
        <div class="modal__body">
          <div data-backup-modal-message class="muted small"></div>

          <div data-backup-restore-options style="margin-top:12px; display:none">
            <div style="font-weight:800; margin-bottom:6px">Restore options</div>
            <div class="row" style="gap:12px; flex-wrap:wrap">
              <label style="display:inline-flex; gap:8px; align-items:center" class="muted small">
                <input type="checkbox" data-backup-opt-uploads />
                <span>Include uploads</span>
              </label>
              <label style="display:inline-flex; gap:8px; align-items:center" class="muted small">
                <input type="checkbox" data-backup-opt-sessions />
                <span>Include sessions</span>
              </label>
            </div>
          </div>

          <div class="actions" style="gap:10px; justify-content:flex-end; margin-top:14px">
            <button class="btn" type="button" data-backup-modal-cancel>Cancel</button>
            <button class="btn btn-primary" type="button" data-backup-modal-confirm>Confirm</button>
          </div>
        </div>
      </div>
    </div>

    <script nonce="<%= cspNonce %>">
      (function () {
        const all = document.getElementById('selectAllBackups');
        const deleteBtn = document.getElementById('deleteSelectedBtn');
        const multiForm = document.getElementById('multiDeleteForm');
        const restoreForm = document.getElementById('singleRestoreForm');
        const deleteForm = document.getElementById('singleDeleteForm');

        const modal = document.querySelector('[data-backup-modal]');
        const modalTitle = modal ? modal.querySelector('[data-backup-modal-title]') : null;
        const modalMsg = modal ? modal.querySelector('[data-backup-modal-message]') : null;
        const modalRestoreOpts = modal ? modal.querySelector('[data-backup-restore-options]') : null;
        const optUploads = modal ? modal.querySelector('[data-backup-opt-uploads]') : null;
        const optSessions = modal ? modal.querySelector('[data-backup-opt-sessions]') : null;
        const modalCancel = modal ? modal.querySelector('[data-backup-modal-cancel]') : null;
        const modalConfirm = modal ? modal.querySelector('[data-backup-modal-confirm]') : null;
        const modalClose = modal ? modal.querySelector('[data-modal-close]') : null;

        const getBoxes = () => Array.prototype.slice.call(document.querySelectorAll('input.backup-select'));
        const updateDeleteState = () => {
          if (!deleteBtn) return;
          const boxes = getBoxes();
          const anyChecked = boxes.some((b) => b.checked);
          deleteBtn.disabled = !anyChecked;
        };

        const isTgz = (name) => /\.tgz$/i.test(String(name || ''));
        const isSessionsDb = (name) => /^sessions_\d{8}_\d{6}\.db$/i.test(String(name || ''));

        const setHidden = (form, name, value) => {
          if (!form) return;
          const el = form.querySelector(`input[name="${name}"]`);
          if (el) el.value = value;
        };

        function isOpen(m) {
          return Boolean(m && m.classList.contains('is-open'));
        }

        function show(m) {
          if (!m) return;
          m.classList.add('is-open');
          m.setAttribute('aria-hidden', 'false');
          document.body.classList.add('modal-open');
          if (modalCancel) modalCancel.focus();
        }

        function hide(m) {
          if (!m) return;
          m.classList.remove('is-open');
          m.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('modal-open');
        }

        let modalState = { kind: null, file: null, selectedCount: 0 };

        function setModal(kind, { file, selectedCount } = {}) {
          modalState = { kind, file: file || null, selectedCount: Number(selectedCount || 0) };
          if (!modalTitle || !modalMsg || !modalConfirm) return;

          // Reset restore opts.
          if (modalRestoreOpts) modalRestoreOpts.style.display = 'none';
          if (optUploads) optUploads.checked = false;
          if (optSessions) optSessions.checked = false;

          if (kind === 'restore') {
            modalTitle.textContent = 'Restore backup';
            modalConfirm.textContent = 'Restore';
            modalMsg.textContent = `Restore “${String(file || '')}”? This will restart the server.`;

            if (isTgz(file)) {
              if (modalRestoreOpts) modalRestoreOpts.style.display = '';
              // default: include uploads, exclude sessions
              if (optUploads) optUploads.checked = true;
              if (optSessions) optSessions.checked = false;
            }
          } else if (kind === 'delete-one') {
            modalTitle.textContent = 'Delete backup';
            modalConfirm.textContent = 'Delete';
            modalMsg.textContent = `Delete “${String(file || '')}”?`;
          } else if (kind === 'delete-selected') {
            modalTitle.textContent = 'Delete backups';
            modalConfirm.textContent = 'Delete selected';
            modalMsg.textContent = `Delete ${modalState.selectedCount} selected backup file(s)?`;
          }
        }

        function openRestore(file) {
          if (!modal) return;
          const f = String(file || '').trim();
          if (!f) return;
          setModal('restore', { file: f });
          show(modal);
        }

        function openDeleteOne(file) {
          if (!modal) return;
          const f = String(file || '').trim();
          if (!f) return;
          setModal('delete-one', { file: f });
          show(modal);
        }

        function openDeleteSelected() {
          if (!modal) return;
          const boxes = getBoxes();
          const selected = boxes.filter((b) => b.checked);
          if (!selected.length) return;
          setModal('delete-selected', { selectedCount: selected.length });
          show(modal);
        }

        function confirmModalAction() {
          if (!modalState || !modalState.kind) return;

          if (modalState.kind === 'restore') {
            if (!restoreForm) return;
            const f = String(modalState.file || '').trim();
            if (!f) return;

            setHidden(restoreForm, 'file', f);
            setHidden(restoreForm, 'restore_uploads', '');
            setHidden(restoreForm, 'restore_sessions', '');

            if (isTgz(f)) {
              if (optUploads && optUploads.checked) setHidden(restoreForm, 'restore_uploads', '1');
              if (optSessions && optSessions.checked) setHidden(restoreForm, 'restore_sessions', '1');
            } else if (isSessionsDb(f)) {
              // sessions_*.db needs restore_sessions=1 or it does nothing.
              setHidden(restoreForm, 'restore_sessions', '1');
            }

            hide(modal);
            restoreForm.submit();
            return;
          }

          if (modalState.kind === 'delete-one') {
            if (!deleteForm) return;
            const f = String(modalState.file || '').trim();
            if (!f) return;
            setHidden(deleteForm, 'file', f);
            hide(modal);
            deleteForm.submit();
            return;
          }

          if (modalState.kind === 'delete-selected') {
            if (!multiForm) return;
            hide(modal);
            multiForm.submit();
          }
        }

        updateDeleteState();

        // Enable/disable delete when individual boxes change.
        getBoxes().forEach((b) => {
          b.addEventListener('change', updateDeleteState);
        });

        if (deleteBtn) {
          deleteBtn.addEventListener('click', function () {
            openDeleteSelected();
          });
        }

        Array.prototype.slice.call(document.querySelectorAll('button.js-restore')).forEach((btn) => {
          btn.addEventListener('click', function () {
            openRestore(btn.getAttribute('data-file'));
          });
        });

        Array.prototype.slice.call(document.querySelectorAll('button.js-delete')).forEach((btn) => {
          btn.addEventListener('click', function () {
            openDeleteOne(btn.getAttribute('data-file'));
          });
        });

        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target && e.target.hasAttribute('data-modal-backdrop')) hide(modal);
          });
        }

        if (modalClose) modalClose.addEventListener('click', () => hide(modal));
        if (modalCancel) modalCancel.addEventListener('click', () => hide(modal));
        if (modalConfirm) modalConfirm.addEventListener('click', () => confirmModalAction());

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen(modal)) hide(modal);
        });

        if (!all) return;
        all.addEventListener('change', function () {
          const boxes = getBoxes();
          boxes.forEach((b) => {
            b.checked = all.checked;
          });
          updateDeleteState();
        });
      })();
    </script>
  <% } %>
</div>

<div class="muted small" style="margin-top:10px">
  Note: restoring creates a safety backup first (so you can roll back if needed), then restarts the server. With PM2 this restarts automatically; without PM2 you may need to start the server again manually.
</div>

<%- include('../shared/bottom') %>
